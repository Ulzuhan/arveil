<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later ask separately about cloud backups and device
  transfers. Both are refused for everything this application stores: the
  profile database, its write-ahead log, attachments and the wrapped key.
  A device transfer is as much a copy as a backup is.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
